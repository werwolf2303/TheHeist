<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The prize video call's self-view (see heist.platform.CameraPreview). Not required: a device/user
         without a usable front camera just never gets a self-view, exactly like the original on a device
         with no front-facing AVCaptureDevice. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- CameraX and its transitive deps declare minSdk 14; camera code is guarded at runtime by SDK_INT >= 21 -->
    <uses-sdk tools:overrideLibrary="androidx.camera.lifecycle,androidx.camera.core,androidx.camera.camera2,androidx.core,androidx.lifecycle,androidx.lifecycle.livedata,androidx.lifecycle.livedata.core,androidx.lifecycle.common,androidx.lifecycle.runtime,androidx.concurrent,androidx.concurrent.futures,androidx.annotation,androidx.annotation.experimental,androidx.exifinterface,androidx.arch.core,androidx.arch.core.runtime,androidx.arch.core.common,androidx.collection,androidx.versionedparcelable,androidx.tracing,androidx.interpolator" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|layoutDirection|fontScale|colorMode|locale"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
